---
// A lightweight, dependency-free particle "constellation" that reacts to the
// pointer. Drifting dots are joined by lines when close; lines also reach out
// to the cursor, and particles gently repel from it. Themed via --accent, it
// pauses when the tab is hidden and honours prefers-reduced-motion.
---

<canvas class="particle-canvas" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.particle-canvas');
  const ctx = canvas ? canvas.getContext('2d') : null;

  if (canvas && ctx) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const LINK_DIST = 130; // px: draw a line between two particles this close
    const MOUSE_DIST = 175; // px: pointer influence radius

    let width = 0;
    let height = 0;
    let particles: { x: number; y: number; vx: number; vy: number }[] = [];
    const mouse = { x: null as number | null, y: null as number | null };

    let lineRgb = '110,168,254';
    let dotRgb = '110,168,254';

    function hexToRgb(hex: string) {
      const h = hex.replace('#', '').trim();
      const full = h.length === 3 ? h.split('').map((c) => c + c).join('') : h;
      if (full.length !== 6) return null;
      const n = parseInt(full, 16);
      return { r: (n >> 16) & 255, g: (n >> 8) & 255, b: n & 255 };
    }

    function readColors() {
      const accent = getComputedStyle(document.documentElement)
        .getPropertyValue('--accent')
        .trim();
      const rgb = hexToRgb(accent);
      if (rgb) {
        lineRgb = `${rgb.r},${rgb.g},${rgb.b}`;
        dotRgb = lineRgb;
      }
    }

    function resize() {
      const rect = canvas!.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas!.width = Math.floor(width * dpr);
      canvas!.height = Math.floor(height * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.min(110, Math.max(28, Math.floor((width * height) / 14000)));
      particles = Array.from({ length: count }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.35,
        vy: (Math.random() - 0.5) * 0.35,
      }));
    }

    function draw() {
      ctx!.clearRect(0, 0, width, height);

      for (const p of particles) {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0) p.x += width;
        else if (p.x > width) p.x -= width;
        if (p.y < 0) p.y += height;
        else if (p.y > height) p.y -= height;

        if (mouse.x !== null && mouse.y !== null) {
          const dx = p.x - mouse.x;
          const dy = p.y - mouse.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < MOUSE_DIST * MOUSE_DIST && d2 > 0.01) {
            const d = Math.sqrt(d2);
            const force = ((MOUSE_DIST - d) / MOUSE_DIST) * 0.9;
            p.x += (dx / d) * force;
            p.y += (dy / d) * force;
          }
        }
      }

      ctx!.lineWidth = 1;
      for (let i = 0; i < particles.length; i++) {
        const a = particles[i];
        for (let j = i + 1; j < particles.length; j++) {
          const b = particles[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < LINK_DIST * LINK_DIST) {
            const o = (1 - Math.sqrt(d2) / LINK_DIST) * 0.5;
            ctx!.strokeStyle = `rgba(${lineRgb},${o})`;
            ctx!.beginPath();
            ctx!.moveTo(a.x, a.y);
            ctx!.lineTo(b.x, b.y);
            ctx!.stroke();
          }
        }
        if (mouse.x !== null && mouse.y !== null) {
          const dx = a.x - mouse.x;
          const dy = a.y - mouse.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < MOUSE_DIST * MOUSE_DIST) {
            const o = (1 - Math.sqrt(d2) / MOUSE_DIST) * 0.65;
            ctx!.strokeStyle = `rgba(${lineRgb},${o})`;
            ctx!.beginPath();
            ctx!.moveTo(a.x, a.y);
            ctx!.lineTo(mouse.x, mouse.y);
            ctx!.stroke();
          }
        }
      }

      ctx!.fillStyle = `rgba(${dotRgb},0.85)`;
      for (const p of particles) {
        ctx!.beginPath();
        ctx!.arc(p.x, p.y, 1.8, 0, Math.PI * 2);
        ctx!.fill();
      }
    }

    let raf = 0;
    let running = false;
    function loop() {
      draw();
      raf = requestAnimationFrame(loop);
    }
    function start() {
      if (!running && !reduceMotion) {
        running = true;
        loop();
      }
    }
    function stop() {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
      running = false;
    }

    function onPointerMove(e: PointerEvent) {
      const rect = canvas!.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      if (x >= 0 && y >= 0 && x <= width && y <= height) {
        mouse.x = x;
        mouse.y = y;
      } else {
        mouse.x = null;
        mouse.y = null;
      }
    }

    readColors();
    resize();
    if (reduceMotion) draw();
    else start();

    window.addEventListener('pointermove', onPointerMove, { passive: true });
    window.addEventListener('pointerout', () => {
      mouse.x = null;
      mouse.y = null;
    });

    let resizeTimer: number;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        readColors();
        resize();
        if (reduceMotion) draw();
      }, 150);
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    window
      .matchMedia('(prefers-color-scheme: dark)')
      .addEventListener('change', () => {
        readColors();
        if (reduceMotion) draw();
      });
  }
</script>
